---
import "../styles/global.css";
import { estiloVars, urlFuentes, url } from "../lib/datos";

interface Props {
  titulo: string;
  descripcion: string;
  favicon: string;      // nombre del archivo del logo, p. ej. "logo.svg"
}
const { titulo, descripcion, favicon } = Astro.props;
---

<!doctype html>
<html lang="es" style={estiloVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <!-- Open Graph básico -->
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={url(favicon)} />
    <!-- Fuentes: preconnect primero, luego la hoja de estilos -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={urlFuentes} />
  </head>
  <body>
    <a class="salto" href="#inicio">Saltar al contenido</a>
    <slot />
  </body>
</html>
